<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.SetupEngine.UI.Pages.SecurityNoticePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenClaw.SetupEngine.UI.Controls"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <Style x:Key="BenefitHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="BenefitDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Padding="40,16,40,24" RowDefinitions="Auto,*,Auto">
        <controls:SetupProgressIndicator x:Name="FlowProgress" ShowStageLabels="True" />

        <ScrollViewer x:Name="WelcomeScroller" Grid.Row="1" Margin="0,16,0,16"
                      Padding="16,0" MaxWidth="640" HorizontalContentAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Spacing="4">
                    <!-- Share the transparent motion gutter with the heading without shrinking the artwork. -->
                    <controls:OnboardingMascot x:Name="MascotHero" Mood="Idle"
                                              Margin="0,0,0,-20" HorizontalAlignment="Center" />
                    <TextBlock x:Name="WelcomeTitle" x:Uid="Onboarding_V2_WelcomeTitle"
                               Text="A little help.&#x0a;A lot of possibility."
                               Style="{StaticResource TitleTextBlockStyle}"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="WelcomeDescription" x:Uid="Onboarding_Flow_WelcomeDescription"
                               Margin="0,8,0,0" MaxWidth="560" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="OpenClaw connects an AI assistant to tools on your PC."
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,32,0,0" Spacing="16">
                    <Grid x:Name="PcFeature" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <SymbolIcon Symbol="Accept" VerticalAlignment="Top" Margin="0,4,0,0"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Uid="Onboarding_V2_WelcomePc" Style="{StaticResource BenefitHeadingStyle}"
                                       Text="Choose your PC tools" />
                            <TextBlock x:Uid="Onboarding_V2_WelcomePcDescription" Style="{StaticResource BenefitDescriptionStyle}"
                                       Text="Start with the access that suits you." />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="GatewayFeature" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <SymbolIcon Symbol="Accept" VerticalAlignment="Top" Margin="0,4,0,0"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Uid="Onboarding_V2_WelcomeGateway" Style="{StaticResource BenefitHeadingStyle}"
                                       Text="Connect your AI" />
                            <TextBlock x:Uid="Onboarding_V2_WelcomeGatewayDescription" Style="{StaticResource BenefitDescriptionStyle}"
                                       Text="Use a provider or available model you choose." />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="ChatFeature" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <SymbolIcon Symbol="Accept" VerticalAlignment="Top" Margin="0,4,0,0"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Uid="Onboarding_V2_WelcomeChat" Style="{StaticResource BenefitHeadingStyle}"
                                       Text="Start a conversation" />
                            <TextBlock x:Uid="Onboarding_V2_WelcomeChatDescription" Style="{StaticResource BenefitDescriptionStyle}"
                                       Text="Chat first. Messaging apps and skills can come later." />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <InfoBar x:Name="SafetyNotice" x:Uid="Onboarding_V2_WelcomeTrust" Margin="0,24,0,0"
                         CornerRadius="{ThemeResource ControlCornerRadius}"
                         IsOpen="True" IsClosable="False" Severity="Warning"
                         Title="Before you start"
                         Message="AI can make mistakes, change or delete files, or expose private information. Use a computer you trust and connect only providers and tools you trust. You can control and limit OpenClaw's access." />
                <HyperlinkButton x:Name="SafetyLink" x:Uid="Onboarding_Copy_SafetyLink"
                                 Margin="0,24,0,0" HorizontalAlignment="Left"
                                 Content="Learn more about risks and safety" NavigateUri="https://trust.openclaw.ai">
                    <HyperlinkButton.ContentTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind Mode=OneWay}" TextWrapping="Wrap" MaxWidth="560" />
                        </DataTemplate>
                    </HyperlinkButton.ContentTemplate>
                </HyperlinkButton>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="ContinueButton" x:Uid="Onboarding_V2_Continue" Grid.Row="2"
                MinWidth="180" MinHeight="40" HorizontalAlignment="Right"
                Style="{StaticResource AccentButtonStyle}" Content="Get started" Click="Continue_Click">
            <Button.ContentTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                </DataTemplate>
            </Button.ContentTemplate>
        </Button>
    </Grid>
</Page>
